---
import RoleRotator from "./react/RoleRotator";
import { site } from "../data/site";
---

<section id="top" class="hero-section relative overflow-hidden">
  <!-- Aurora blobs — confined to the hero, animated via transform only. -->
  <div
    class="blob -left-16 -top-16 h-48 w-48 bg-[var(--color-violet)]/30 animate-[float-a_16s_ease-in-out_infinite] sm:-left-24 sm:-top-24 sm:h-80 sm:w-80"
    aria-hidden="true"
  >
  </div>
  <div
    class="blob -right-12 top-10 h-56 w-56 bg-[var(--color-pink)]/25 animate-[float-b_20s_ease-in-out_infinite] sm:-right-16 sm:h-96 sm:w-96"
    aria-hidden="true"
  >
  </div>
  <div
    class="blob bottom-0 left-1/3 h-44 w-44 bg-[var(--color-amber)]/20 animate-[float-a_18s_ease-in-out_infinite] sm:h-72 sm:w-72"
    aria-hidden="true"
  >
  </div>

  <!-- Cursor-follow spotlight — plain CSS var + a tiny vanilla listener
       below, not a React island: it's a style update, not stateful UI. -->
  <div id="hero-spotlight" class="pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="eyebrow">{site.location} · open to security engineering roles</p>

    <h1 class="mt-5 max-w-3xl text-4xl font-bold leading-[1.1] tracking-tight text-[var(--color-text)] sm:text-6xl">
      I build tools that <span class="gradient-text">catch attackers.</span>
    </h1>

    <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-2 text-lg text-[var(--color-text-dim)] sm:text-xl">
      <span>{site.role}</span>
      <span aria-hidden="true">·</span>
      <RoleRotator client:load />
    </p>

    <p class="mt-5 max-w-lg text-[var(--color-text-dim)]">
      Honeypots, telemetry pipelines, and low-level systems software — the
      tools that watch, contain, and study attackers instead of just
      blocking them.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="#aegis" class="btn-primary">
        View Aegis →
      </a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">
        GitHub ↗
      </a>
    </div>
  </div>
</section>

<script>
  const zone = document.querySelector<HTMLElement>(".hero-section");
  const spotlight = document.getElementById("hero-spotlight");
  const canHover = window.matchMedia("(pointer: fine)").matches;
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (zone && spotlight && canHover && !prefersReduced) {
    let raf: number | null = null;
    zone.addEventListener("pointermove", (e) => {
      if (raf) return;
      // Coordinates relative to the section, which is `spotlight`'s
      // containing block (it's `absolute inset-0` inside the section) —
      // using raw viewport coordinates here would misplace the glow
      // whenever the section isn't flush with the viewport's top-left.
      const rect = zone.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      raf = requestAnimationFrame(() => {
        spotlight.style.background = `radial-gradient(500px circle at ${x}px ${y}px, color-mix(in srgb, var(--color-violet) 16%, transparent), transparent 55%)`;
        raf = null;
      });
    });
  }
</script>

---
const words = [
  "HONEYPOTS",
  "eBPF",
  "RUST",
  "SIEM",
  "THREAT HUNTING",
  "OVERLAYFS",
  "NMAP",
  "LINUX INTERNALS",
  "WIRESHARK",
  "C / C++",
  "INCIDENT RESPONSE",
  "METASPLOIT",
];
---

<div class="overflow-hidden border-y border-[var(--color-border)] bg-[var(--color-bg-alt)] py-4" aria-hidden="true">
  <div class="marquee-track">
    {
      [0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {words.map((word) => (
            <span class="mx-4 flex items-center gap-4 text-sm font-bold uppercase tracking-wide text-[var(--color-text-muted)]">
              {word}
              <span class="h-1.5 w-1.5 rounded-full bg-[image:var(--gradient-brand)]" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

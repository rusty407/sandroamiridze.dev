---
import { site } from "../data/site";

const links = [
  { href: "#skills", label: "Skills" },
  { href: "#aegis", label: "Aegis" },
  { href: "#projects", label: "Projects" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 bg-[var(--color-bg)]/95">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="flex items-center gap-2 text-sm font-bold text-[var(--color-text)]"
    >
      <span
        class="inline-block h-2.5 w-2.5 rounded-full bg-[image:var(--gradient-brand)] animate-[pulse-dot_2s_ease-in-out_infinite]"
        aria-hidden="true"
      ></span>
      <span>{site.name}</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 text-sm font-medium text-[var(--color-text-dim)] sm:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-[var(--color-violet)]">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile menu: pure HTML/CSS, no JS required -->
    <details class="relative sm:hidden">
      <summary
        class="list-none cursor-pointer select-none rounded-full border border-[var(--color-border-strong)] px-3.5 py-1.5 text-sm font-medium text-[var(--color-text-dim)] marker:content-none [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
      >
        Menu
      </summary>
      <ul
        class="card absolute right-0 mt-2 w-44 p-2 text-sm shadow-xl"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-lg px-3 py-2 font-medium text-[var(--color-text-dim)] hover:bg-[var(--color-bg-alt)] hover:text-[var(--color-violet)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
  <div class="gradient-rule" aria-hidden="true"></div>
</header>
